# LarkAgentX 配置(全部有默认值,按需修改)
# 复制为 .env 放在项目根目录即可生效

# 区域: feishu(飞书国内版) | lark(Lark 国际版 larksuite.com)
# 只决定首次登录走哪边;登录后以凭证里记录的区域为准,切换用 lark auth qr --region <feishu|lark>
LARKX_REGION=feishu

# 启动配置文件独立于数据目录，网页已保存的启动配置优先于下列环境变量
# LARKX_STARTUP_PATH=
# LARKX_PORT=8765

# 数据目录(凭证/消息库/agent 会话)，留空使用程序目录下的 data
LARKX_HOME=

# 消息存储: 留空 = SQLite(自动存到 LARKX_HOME/messages.db)
# 用 MySQL 则填: mysql+pymysql://<user>:<password>@<host>:3306/<db>
LARKX_STORAGE_URL=

# agent 上下文边界: anchor(会话+话题) | chat(会话) | global(全部共享)
LARKX_CONTEXT_SCOPE=anchor

# 命令行 listen 的 agent 后端；网页中的模型接入在设置页单独选择
LARKX_AGENT_BACKEND=codex

# Codex 后端: 先执行 codex login；模型留空使用 CLI 默认模型
# 下列运行参数可在网页分组设置中覆盖，保存后重启仍保留
LARKX_CODEX_MODEL=
LARKX_CODEX_TIMEOUT=180
LARKX_CODEX_REASONING_EFFORT=low
# 网页未设置时的消息停顿秒数(1-30，整数)，默认最长等待 5 秒、合并 20 条
LARKX_BATCH_DELAY=2
LARKX_BATCH_MAX_WAIT=5
LARKX_BATCH_SIZE=20
# 并发与刷新也可在网页“性能与高级”调整
LARKX_MAX_CONCURRENCY=2
LARKX_BACKGROUND_CONCURRENCY=1
LARKX_POLL_INTERVAL=5
LARKX_JOB_POLL_INTERVAL=2
# 普通消息的背景分析间隔（1-600 秒）；网页设置优先，后台最多占用 1 个模型名额
LARKX_BACKGROUND_INTERVAL=30
# 单次模型请求的文本字符预算（24000-200000）；不包含图片，超长正文会压缩
LARKX_CONTEXT_BUDGET=48000
# 若 codex 不在 PATH 中，可指定可执行文件路径
LARKX_CODEX_PATH=

# 数字人系统提示词(留空用内置默认)
LARKX_SYSTEM_PROMPT=

# 收到消息自动标记已读(默认开;手机端未读角标会清掉)
LARKX_MARK_READ=false

# 触发前缀: 只处理以此前缀开头的消息(留空 = 全部处理)
# 例: LARKX_TRIGGER_PREFIX=/run
LARKX_TRIGGER_PREFIX=

# 登录凭证不放这里,用命令管理:
#   lark auth qr                            扫码登录(推荐)
#   lark auth import --cookie "<cookie>"    手动导入

# 群聊仅 @本人时自动回复
LARKX_TRIGGER_GROUP_AT_ONLY=true

# 未在网页设置时的默认回复策略；仅影响“跟随默认”的档案
LARKX_DEFAULT_PRIVATE_REPLY=off
LARKX_DEFAULT_GROUP_REPLY=off

# API 密钥也可通过环境变量提供；网页保存的密钥优先
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# ZAI_API_KEY=
# MOONSHOT_API_KEY=
# ARK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
